{
  "name": "ballotdata",
  "version": "1.0.0",
  "description": "Official JavaScript and TypeScript client for the BallotData API: U.S. ballots, endorsers, endorsements, officeholders, and the live Endorsement Stream.",
  "keywords": [
    "ballotdata",
    "ballot",
    "elections",
    "endorsements",
    "voting",
    "civic",
    "api",
    "sdk",
    "server-sent-events"
  ],
  "homepage": "https://api.ballotdata.net/docs",
  "bugs": {
    "email": "sales@ballotdata.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndorsedByOrg/jslib.git"
  },
  "license": "MIT",
  "author": "BallotData LLC <sales@ballotdata.net> (https://ballotdata.net)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs/*.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs && npm run typecheck",
    "docs": "typedoc",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0"
  }
}
